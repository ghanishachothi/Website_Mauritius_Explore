 "destinations": [
  {
   "slug": "mont-choisy",
   "name": "Mont Choisy",
   "description": "Mont Choisy has one of the longest stretches of white sand on the island, with calm, shallow, clear water that is good for swimming. Shady filao trees line the beach, so you can rest out of the sun. It’s popular with families and walkers, and it’s a lovely place to watch the sun set over the Indian Ocean.",
   "latitude": "-20.007000",
   "longitude": "57.560000",
   "price": "50.00"
  },
  {
   "slug": "notre-dame-auxiliatrice",
   "name": "Notre-Dame Auxiliatrice",
   "description": "This red-roofed church by the sea is one of the most photographed landmarks in the north. It was built in 1938 and is dedicated to Our Lady Help of Christians. Its bright roof stands out against the blue sky and the ocean. Visit the peaceful interior, then walk along the nearby shore. Remember to dress respectfully, especially during services.",
   "latitude": "-19.983600",
   "longitude": "57.613900",
   "price": "125.00"
  },
  {
   "slug": "cap-malheureux",
   "name": "Cap Malheureux",
   "description": "Cap Malheureux is a quiet fishing village at the northern tip of Mauritius. Its red-roofed Notre-Dame Auxiliatrice chapel looks out over turquoise water towards the islets in the distance. Walk along the shore, watch the colourful fishing boats, and stay for sunset, when the whole bay turns golden. It’s a good spot for photos, a slow stroll and a seafood lunch.",
   "latitude": "-19.985500",
   "longitude": "57.614500",
   "price": "75.00"
  },
  {
   "slug": "fort-adelaide",
   "name": "Fort Adelaide",
   "description": "Fort Adelaide, also known as La Citadelle, was built by the British in the 1830s on a hilltop above Port Louis. Walk the old stone ramparts, see the cannons that once guarded the harbour, and enjoy panoramic views over the city, the port and the mountains behind. Visit in the late afternoon for cooler weather and softer light.",
   "latitude": "-20.166000",
   "longitude": "57.507500",
   "price": "50.00"
  },
  {
   "slug": "local-markets",
   "name": "Local Markets",
   "description": "A visit to the local markets shows everyday Mauritian life. Browse stalls of fresh fruit and vegetables, aromatic spices, woven baskets and handmade crafts, then try street food such as dholl puri, gateaux piments and fresh sugarcane juice. Bring small change, go early, and don’t be shy about chatting with the stallholders.",
   "latitude": "-20.161800",
   "longitude": "57.503600",
   "price": "75.00"
  },
  {
   "slug": "coin-de-mire",
   "name": "Coin de Mire",
   "description": "Coin de Mire is a rocky islet about 5 km off the northern coast. Its steep cliffs rise straight out of the deep blue sea, and it’s a protected nature reserve. Boat trips pass close to the cliffs, and the surrounding waters are good for snorkelling and diving, with clear water and plenty of marine life. Go on a calm morning for the best visibility.",
   "latitude": "-19.937000",
   "longitude": "57.612000",
   "price": "1000.00"
  }
 ],
