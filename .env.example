# Copy this file to ".env" (same folder as manage.py) and fill it in. NEVER commit ".env".
DATABASE_URL=postgresql://postgres.PROJECTREF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
SUPABASE_BUCKET=media
SUPABASE_S3_ENDPOINT=https://PROJECTREF.supabase.co/storage/v1/s3
SUPABASE_S3_REGION=REGION
SUPABASE_S3_KEY=access-key-id
SUPABASE_S3_SECRET=secret-access-key
SUPABASE_PUBLIC_BASE=https://PROJECTREF.supabase.co/storage/v1/object/public/media
